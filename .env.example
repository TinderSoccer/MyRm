# Shared group (see SUPABASE.md). Leave empty to keep the group local to the phone.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Reading the WOD from a whiteboard photo (api/wod-photo.ts, server only — never VITE_/NEXT_PUBLIC_).
# Set in Vercel → Settings → Environment Variables. Leave empty and the photo button says it isn't enabled.
ANTHROPIC_API_KEY=
